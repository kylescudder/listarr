{
  "name": "listarr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "start": "bun server/production.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "bun e2e/run.ts",
