# TMDB API Read Access Token (not the v3 API key)
TMDB_READ_TOKEN=
APP_ORIGIN=http://127.0.0.1:3211
# Optional internal URL reachable from Radarr; defaults to APP_ORIGIN.
FEED_ORIGIN=
# Clerk publishable key is public and baked into the client at build time.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for offline session verification.
CLERK_JWT_KEY=
RADARR_ALLOWED_USER_IDS=
# Optional: set both to hide existing Radarr films when browsing.
# Also used for direct list creation. Leave both blank to browse without Radarr.
RADARR_URL=
RADARR_API_KEY=
RADARR_QUALITY_PROFILE_ID=
RADARR_ROOT_FOLDER=/movies
HOST=127.0.0.1
PORT=3211
LISTARR_REVISION=development
